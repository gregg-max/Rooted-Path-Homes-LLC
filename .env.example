# Copy this file to .env.local for trying the site on your own computer.
# On Vercel, add the same names under Project Settings → Environment Variables.
# Never commit the real key. This file only shows the names.

# Two free keys from https://web3forms.com, one per inbox.
# The free plan can email only one person per key, and copying a second person
# is a paid feature. The site sends each form twice from the visitor's browser:
# once with Gregg's key, once with Kristi's key. Both keys are required.
# They are not passwords, but they stay out of GitHub.
WEB3FORMS_ACCESS_KEY=
WEB3FORMS_KRISTI_ACCESS_KEY=

# Optional. The public address of the site, with no slash at the end.
# Set this once a custom domain is connected so Google and link previews
# use the real address. Example:
# NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=
